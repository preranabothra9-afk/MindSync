# ==========================================================================
# AI MODEL PROVIDER CREDENTIALS
# ==========================================================================
# Every model below is a REAL provider adapter. Each variable is optional, but
# any model whose variable is missing will show an "API key required" notice
# instead of an answer. Keys are read on the server only and are never sent to
# the browser.
#
# The default comparison prompt uses three models from three different labs:
#   1. Gemini 3.5 Flash  -> Google AI Studio
#   2. GPT-OSS 120B      -> Groq
#   3. Qwen3.8 27B       -> Groq
#
# So a working three-model comparison only needs GEMINI_API_KEY + GROQ_API_KEY.

# GEMINI_API_KEY: Google AI Studio key. Required for the Gemini models.
# Free tier, no credit card. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="your_api_key"

# GROQ_API_KEY: Groq key. Powers GPT-OSS 120B/20B and Qwen3.8 27B.
# These three are on Groq's FREE plan (30 RPM, 1000 requests/day).
# Get one at https://console.groq.com/keys
# Note: llama-3.3-70b is also registered but Groq gates it behind a paid plan.
GROQ_API_KEY=""

# MISTRAL_API_KEY: Optional. Enables the Mistral Small model.
# Free Experiment tier, no credit card. Get one at https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=""

# NVIDIA_API_KEY: Optional. Enables the DeepSeek R1 model.
# Free developer tier, 40 RPM. Get one at https://build.nvidia.com
NVIDIA_API_KEY=""

# JWT_ACCESS_SECRET: Cryptographic secret for signing access tokens
JWT_ACCESS_SECRET="synapse-ai-access-quantum-secret-2026"

# JWT_REFRESH_SECRET: Cryptographic secret for signing refresh tokens
JWT_REFRESH_SECRET="synapse-ai-refresh-quantum-secret-2026"

# CLIENT_URL: The trusted web address (domain/URL) where the browser interface of the application is running. 
# The server uses this to securely let your browser talk to backend APIs and web sockets (CORS).
CLIENT_URL="http://localhost:3000"

# NODE_ENV: Runtime deployment tier (e.g., development, production)
NODE_ENV="development"

# CONTEXT_DEBUG: When "true", every AI prompt is printed to the server console
# immediately after the context is composed. Use this to inspect what the model
# is being told about the room's history without editing socket.ts.
CONTEXT_DEBUG="false"

# JWT_SECRET: Security token decryption seed for authenticating collaborators.
JWT_SECRET="synapse-ai-exclusive-quantum-secret-2026"

# MONGODB_URI: (Optional) The connection URI for your MongoDB database (e.g. MongoDB Atlas).
# If not provided, MindSync automatically runs in high-performance Local JSON Persistent mode.
MONGODB_URI="MongoDB Atlas URI"

# Initial Platform Administration Credentials (MERN System Startup Auto-Seeder)
ADMIN_NAME="System Super Administrator"
ADMIN_EMAIL="admin@synapse.ai"
ADMIN_PASSWORD="Password@123"

# ==========================================================================
# EMAIL DELIVERY (OPTIONAL)
# ==========================================================================
# Outbound email. Three providers are supported, tried in this order:
#
#   1. BREVO (recommended) — SMTP relay over port 2525, which sidesteps the
#      outbound 465/587 blocks that make Gmail unusable on cloud hosts
#      (Render, fly.io, ...). Free tier: 300 emails/day, no credit card.
#        a. Sign up at https://www.brevo.com
#        b. Settings -> SMTP & API -> copy the SMTP "Login" and generate a key
#           on that page. IMPORTANT: the Login is a generated address like
#           "abcd1234@smtp-brevo.com" — NOT the email you sign into brevo.com
#           with. Using the website login causes "535 Authentication failed".
#        c. In Brevo, verify the sender address you will mail FROM
#        d. Paste them below as BREVO_USER / BREVO_PASS
#      BREVO_USER is used as the From: address only when it is a real mailbox;
#      see the note below the variables.
#
#   2. RESEND — sends over plain HTTPS (port 443), so it also works on cloud
#      hosts that block SMTP. Free tier: 3,000 emails/month, no credit card,
#      instant API key. https://resend.com -> API Keys -> "Create API Key".
#      Note: with no verified domain Resend only allows the shared onboarding
#      sender, and that sender can only deliver to the email address that owns
#      the Resend account. Set RESEND_FROM to "Your Brand <you@yourdomain.com>"
#      once a custom domain is verified.
#
#   3. SMTP (Gmail) — legacy fallback, used only when neither Brevo nor a
#      Resend key is configured. Gmail frequently blocks SMTP from cloud IPs.
#      For Gmail, create an App Password (not your account password) at
#      https://myaccount.google.com/apppasswords and enable 2-Step Verification first.
#
# While ALL are blank, the app runs in "no mail" mode: verification and reset
# links are returned through the corresponding API response instead of being
# emailed, so the flows can still be tested end to end locally.

BREVO_USER=""
BREVO_PASS=""
BREVO_HOST="smtp-relay.brevo.com"
BREVO_PORT="2525"
# The address mail is sent FROM — must be a verified sender in Brevo (Senders &
# IP -> add/verify it). Required for Brevo: the generated "…@smtp-brevo.com"
# login is not a valid sender address.
MAIL_FROM_ADDRESS=""
RESEND_API_KEY=""
RESEND_FROM="MindSync <onboarding@resend.dev>"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM_NAME="MindSync"
APP_URL="http://localhost:3000"
